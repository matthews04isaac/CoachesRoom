{
  "name": "benchiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BenchIQ — all-in-one hockey coaching and player development platform",
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,gray \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test server/api.test.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
