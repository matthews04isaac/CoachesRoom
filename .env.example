# Port for the API server (the Vite dev server proxies /api to it)
PORT=4000
# Optional: enables the AI Coach. Without a key, the AI Coach page explains how to enable it
# and the rule-based drill recommendations keep working.
# Google Gemini (free tier): create a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Or Anthropic Claude (paid): used when GEMINI_API_KEY is not set
ANTHROPIC_API_KEY=
BENCHIQ_AI_MODEL=claude-opus-5-5
# If both keys are set, force one: gemini | anthropic
BENCHIQ_AI_PROVIDER=
# SQLite file location (default: data/benchiq.db)
BENCHIQ_DB=data/benchiq.db
